{
  "name": "habit-tracker",
  "productName": "Habit Tracker",
  "version": "1.0.0",
  "description": "Simple black and red habit tracker with a monthly grid, a 75-day challenge and a fill-bar calendar.",
  "main": "main.js",
  "author": "Anish Garg",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/logic.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.anishgarg.habittracker",
    "productName": "Habit Tracker",
    "files": ["main.js", "preload.js", "src/**/*"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage" }
  }
}
